# Telegram
BOT_TOKEN=your_telegram_bot_token
WEBHOOK_URL=https://your-domain.com
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=your_webhook_secret

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=dream_diary
POSTGRES_PASSWORD=changeme
POSTGRES_DB=dream_diary

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Kimi LLM (Moonshot API) — https://platform.moonshot.cn/console/api-keys
KIMI_API_KEY=your_kimi_api_key
LLM_API_BASE=https://api.moonshot.ai/v1
# Альтернатива для Китая: https://api.moonshot.cn/v1
LLM_MODEL=kimi-k2.6
# Другие модели: kimi-k3, kimi-k2.5 (sunset 31.08.2026)
# Устаревшие: moonshot-v1-32k — недоступны для новых ключей
LLM_TIMEOUT=90
LLM_MAX_RETRIES=3

# Whisper (опционально, только OpenAI — Kimi не поддерживает STT)
# WHISPER_API_KEY=your_openai_api_key
# WHISPER_API_BASE=https://api.openai.com/v1
# WHISPER_MODEL=whisper-1

# Security
ENCRYPTION_KEY=your_32_byte_base64_encryption_key

# App
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=production

# Railway (auto-provided when you add plugins — do not set manually)
# DATABASE_URL=postgresql://...
# REDIS_URL=redis://...
# PORT=8000
